{
  "schemaVersion": 1,
  "name": "Release communications guardrails",
  "rules": [
    {
      "id": "no-internal-markers",
      "kind": "blockedPhrase",
      "phrase": "internal only"
    },
    {
      "id": "local-language-required",
      "kind": "requiredPhrase",
