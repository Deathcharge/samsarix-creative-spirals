{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/creative-spirals/approval-policy-v1.schema.json",
  "title": "Samsarix Creative Spirals approval policy",
  "description": "Reusable unsigned role and reviewer-count requirements for collecting source-bound plan approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "minimumTotal", "distinctReviewers", "requirements"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "minimumTotal": {"type": "integer", "minimum": 1, "maximum": 50},
    "distinctReviewers": {"type": "boolean"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "minimum"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "minimum": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    }
  }
}
