{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/creative-spirals/media-package-v1.schema.json",
  "title": "Samsarix Creative Spirals approval-bound handoff media",
  "description": "A bounded, content-addressed index that binds exact static image bytes to a campaign plan and approved handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "mediaId",
    "mediaHash",
    "planId",
    "sourceHash",
    "totalBytes",
    "assets"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "samsarix.handoff-media"},
    "mediaId": {"type": "string", "pattern": "^scm_[0-9a-f]{12}$"},
    "mediaHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planId": {"type": "string", "pattern": "^scp_[0-9a-f]{12}$"},
    "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "totalBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "source",
        "reference",
        "packetPath",
        "contentType",
        "width",
        "height",
        "bytes",
        "sha256",
        "altText",
        "platforms"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1, "maximum": 100},
        "source": {
          "type": "string",
          "minLength": 6,
          "maxLength": 500,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^\\u0000-\\u001F\\u007F]+\\.json$"
        },
        "reference": {
          "type": "string",
          "minLength": 5,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[:\\\\])[^\\u0000-\\u001F\\u007F]+\\.(?:[jJ][pP][eE]?[gG]|[pP][nN][gG])$"
        },
        "packetPath": {
          "type": "string",
          "pattern": "^media/[0-9a-f]{64}\\.(?:jpg|png)$"
        },
        "contentType": {"enum": ["image/jpeg", "image/png"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 100000},
        "height": {"type": "integer", "minimum": 1, "maximum": 100000},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "altText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\r\\n\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["x", "linkedin", "bluesky", "mastodon", "discord"]}
        }
      }
    }
  }
}
