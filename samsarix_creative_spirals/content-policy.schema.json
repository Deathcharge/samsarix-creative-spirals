{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/creative-spirals/content-policy-v1.schema.json",
  "title": "Samsarix Creative Spirals content policy",
  "description": "A bounded set of literal phrase rules evaluated against rendered platform drafts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "phrase"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {"enum": ["blockedPhrase", "requiredPhrase"]},
        "phrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["x", "linkedin", "bluesky", "mastodon", "discord"]}
        },
        "severity": {"enum": ["warning", "error"], "default": "error"},
        "caseSensitive": {"type": "boolean", "default": false}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "sourceHash", "name"],
      "properties": {
        "policyId": {"type": "string", "pattern": "^scpol_[0-9a-f]{12}$"},
        "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        }
      }
    }
  }
}
