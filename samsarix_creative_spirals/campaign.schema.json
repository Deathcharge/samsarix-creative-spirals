{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/creative-spirals/campaign-v1.schema.json",
  "title": "Samsarix Creative Spirals campaign",
  "description": "One approved source draft and its requested social-platform outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "body", "platforms"],
  "allOf": [
    {
      "if": {
        "required": ["platformLimits"],
        "properties": {"platformLimits": {"required": ["x"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "x"}}}}
    },
    {
      "if": {
        "required": ["platformLimits"],
        "properties": {"platformLimits": {"required": ["linkedin"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "linkedin"}}}}
    },
    {
      "if": {
        "required": ["platformLimits"],
        "properties": {"platformLimits": {"required": ["bluesky"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "bluesky"}}}}
    },
    {
      "if": {
        "required": ["platformLimits"],
        "properties": {"platformLimits": {"required": ["mastodon"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "mastodon"}}}}
    },
    {
      "if": {
        "required": ["platformLimits"],
        "properties": {"platformLimits": {"required": ["discord"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "discord"}}}}
    },
    {
      "if": {
        "required": ["platformVariants"],
        "properties": {"platformVariants": {"required": ["x"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "x"}}}}
    },
    {
      "if": {
        "required": ["platformVariants"],
        "properties": {"platformVariants": {"required": ["linkedin"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "linkedin"}}}}
    },
    {
      "if": {
        "required": ["platformVariants"],
        "properties": {"platformVariants": {"required": ["bluesky"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "bluesky"}}}}
    },
    {
      "if": {
        "required": ["platformVariants"],
        "properties": {"platformVariants": {"required": ["mastodon"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "mastodon"}}}}
    },
    {
      "if": {
        "required": ["platformVariants"],
        "properties": {"platformVariants": {"required": ["discord"]}}
      },
      "then": {"properties": {"platforms": {"contains": {"const": "discord"}}}}
    },
    {
      "properties": {
        "media": {
          "contains": {"$ref": "#/$defs/appliesToX"},
          "minContains": 0,
          "maxContains": 4
        }
      }
    },
    {
      "properties": {
        "media": {
          "contains": {"$ref": "#/$defs/appliesToLinkedIn"},
          "minContains": 0,
          "maxContains": 4
        }
      }
    },
    {
      "properties": {
        "media": {
          "contains": {"$ref": "#/$defs/appliesToBluesky"},
          "minContains": 0,
          "maxContains": 4
        }
      }
    },
    {
      "properties": {
        "media": {
          "contains": {"$ref": "#/$defs/appliesToMastodon"},
          "minContains": 0,
          "maxContains": 4
        }
      }
    },
    {
      "properties": {
        "media": {
          "contains": {"$ref": "#/$defs/appliesToDiscord"},
          "minContains": 0,
          "maxContains": 4
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Campaign configuration schema version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\r\\n]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]*$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "link": {
      "type": "string",
      "format": "uri",
      "maxLength": 500,
      "pattern": "^https?://\\S+$"
    },
    "hashtags": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 51,
        "description": "Optional leading # followed by letters, numbers, or underscores; runtime validation is Unicode-aware."
      },
      "default": []
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": ["x", "linkedin", "bluesky", "mastodon", "discord"]
      }
    },
    "platformVariants": {
      "type": "object",
      "description": "Optional complete content overrides for requested platforms. Omitted fields do not inherit from the baseline.",
      "maxProperties": 5,
      "additionalProperties": false,
      "properties": {
        "x": {"$ref": "#/$defs/contentVariant"},
        "linkedin": {"$ref": "#/$defs/contentVariant"},
        "bluesky": {"$ref": "#/$defs/contentVariant"},
        "mastodon": {"$ref": "#/$defs/contentVariant"},
        "discord": {"$ref": "#/$defs/contentVariant"}
      }
    },
    "platformLimits": {
      "type": "object",
      "description": "Optional local limits for requested platforms, useful for instance-specific Mastodon limits.",
      "additionalProperties": false,
      "properties": {
        "x": {"type": "integer", "minimum": 1, "maximum": 280},
        "linkedin": {"type": "integer", "minimum": 1, "maximum": 3000},
        "bluesky": {"type": "integer", "minimum": 1, "maximum": 300},
        "mastodon": {"type": "integer", "minimum": 1, "maximum": 100000},
        "discord": {"type": "integer", "minimum": 1, "maximum": 2000}
      }
    },
    "media": {
      "type": "array",
      "description": "Portable static-image metadata. Core validates these references but never opens, copies, or uploads the files.",
      "maxItems": 20,
      "items": {"$ref": "#/$defs/mediaReference"},
      "default": []
    }
  },
  "$defs": {
    "contentVariant": {
      "type": "object",
      "description": "A complete platform content block; body is required and title, link, and hashtags default to absent or empty.",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\r\\n]*$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "link": {
          "type": "string",
          "format": "uri",
          "maxLength": 500,
          "pattern": "^https?://\\S+$"
        },
        "hashtags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 51,
            "description": "Optional leading # followed by letters, numbers, or underscores; runtime validation is Unicode-aware."
          },
          "default": []
        }
      }
    },
    "appliesToX": {
      "anyOf": [
        {"not": {"required": ["platforms"]}},
        {
          "required": ["platforms"],
          "properties": {"platforms": {"contains": {"const": "x"}}}
        }
      ]
    },
    "appliesToLinkedIn": {
      "anyOf": [
        {"not": {"required": ["platforms"]}},
        {
          "required": ["platforms"],
          "properties": {"platforms": {"contains": {"const": "linkedin"}}}
        }
      ]
    },
    "appliesToBluesky": {
      "anyOf": [
        {"not": {"required": ["platforms"]}},
        {
          "required": ["platforms"],
          "properties": {"platforms": {"contains": {"const": "bluesky"}}}
        }
      ]
    },
    "appliesToMastodon": {
      "anyOf": [
        {"not": {"required": ["platforms"]}},
        {
          "required": ["platforms"],
          "properties": {"platforms": {"contains": {"const": "mastodon"}}}
        }
      ]
    },
    "appliesToDiscord": {
      "anyOf": [
        {"not": {"required": ["platforms"]}},
        {
          "required": ["platforms"],
          "properties": {"platforms": {"contains": {"const": "discord"}}}
        }
      ]
    },
    "mediaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "altText"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!\\s)(?!.*(?:/\\s|\\s(?:/|$)))(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.[^/]*)?(?:/|$))[^/\\\\:<>\"|?*\\u0000-\\u001F\\u007F-\\u009F]+(?:/[^/\\\\:<>\"|?*\\u0000-\\u001F\\u007F-\\u009F]+)*\\.(?:[jJ][pP][eE]?[gG]|[pP][nN][gG])$"
        },
        "altText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
        },
        "platforms": {
          "type": "array",
          "description": "Optional non-empty subset of campaign platforms; omission means every requested platform.",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["x", "linkedin", "bluesky", "mastodon", "discord"]}
        }
      }
    }
  }
}
